{
  "name": "movie-night-watchlist",
  "version": "1.0.0",
  "description": "Full-stack movie watchlist tracker with Express, SQLite and session authentication",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "test": "node --test \"tests/*.test.js\"",
    "catalog:seed": "node database/seedCatalog.js",
    "catalog:refresh": "node scripts/refresh-catalog.js",
    "catalog:build": "node scripts/build-catalog.js"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  }
}
