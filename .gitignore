```gitignore
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases and database files
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and test output
*.log
npm-debug.log*
coverage/

# Development tooling
.vscode/
.idea/
.claude/

# Operating system files
.DS_Store
Thumbs.db
```