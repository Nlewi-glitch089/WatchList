# Copy this file to .env and fill in real values. Never commit .env.
# On Render, add these under the service's Environment tab instead.

# MongoDB connection string (required).
#   Local MongoDB:   mongodb://127.0.0.1:27017
#   MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name inside that server (created automatically on first write). Defaults to movie_night.
MONGODB_DB=movie_night

# Port the Express server listens on. Render sets this itself.
PORT=3000

# "development" for local HTTP, "production" when served over HTTPS
# (production enables Secure cookies and requires SESSION_SECRET)
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: TMDB key for movie search. Either the "API Key" or the "API Read Access Token"
# from https://www.themoviedb.org/settings/api works. Leave blank to add movies by hand only.
TMDB_API_KEY=

# Optional: how much the server logs: debug, info, warn, error, or silent.
# Defaults to debug in development and info in production.
# LOG_LEVEL=info
