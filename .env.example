# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on
PORT=3000

# "development" for local HTTP, "production" when served over HTTPS
# (production enables Secure cookies and requires SESSION_SECRET)
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Path to the SQLite database file (created automatically).
# On Render, point this at the persistent disk, e.g. /var/data/movies.db
DB_PATH=./data/movies.db

# Optional: TMDB key for movie search. Either the "API Key" or the "API Read Access Token"
# from https://www.themoviedb.org/settings/api works. Leave blank to add movies by hand only.
TMDB_API_KEY=

# Optional: how much the server logs: debug, info, warn, error, or silent.
# Defaults to debug in development and info in production.
# LOG_LEVEL=info
